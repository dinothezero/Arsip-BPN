<div class="max-w-7xl mx-auto">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Disposisi Surat</h1>
      <p class="text-slate-500 text-sm mt-1">Pelacakan disposisi dan penerusan surat</p>
    </div>
    <div class="flex gap-2">
      <a href="/surat-masuk" class="bg-bpn-600 hover:bg-bpn-700 text-white text-sm font-medium px-4 py-2.5 rounded-xl shadow-lg shadow-bpn-600/25 transition-all hover:shadow-xl hover:-translate-y-0.5">
        <i class="fas fa-inbox mr-2"></i>Disposisi Surat Masuk
      </a>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-5 border-b border-slate-100">
      <form method="GET" class="flex flex-wrap gap-3 items-end">
        <div class="flex-1 min-w-[200px]">
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Cari</label>
          <div class="relative">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input type="text" name="q" value="<%= filters.q || '' %>" placeholder="Cari penerima atau catatan..."
              class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 focus:border-bpn-500 outline-none transition">
          </div>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Tipe</label>
          <select name="tipe" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
            <option value="">Semua</option>
            <option value="masuk" <%= filters.tipe === 'masuk' ? 'selected' : '' %>>Surat Masuk</option>
            <option value="keluar" <%= filters.tipe === 'keluar' ? 'selected' : '' %>>Surat Keluar</option>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Prioritas</label>
          <select name="prioritas" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
            <option value="">Semua</option>
            <% prioritasList.forEach(p => { %>
              <option value="<%= p %>" <%= filters.prioritas === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Status</label>
          <select name="status" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
            <option value="">Semua</option>
            <% statusList.forEach(s => { %>
              <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </div>
        <div class="flex gap-2">
          <button type="submit" class="px-4 py-2 bg-bpn-600 hover:bg-bpn-700 text-white rounded-xl text-sm font-medium transition">
            <i class="fas fa-filter mr-1"></i>Filter
          </button>
          <a href="/disposisi" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-sm font-medium transition">
            <i class="fas fa-rotate-left mr-1"></i>Reset
          </a>
        </div>
      </form>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-slate-50 text-left text-[11px] uppercase tracking-wider text-slate-500">
            <th class="px-5 py-3.5 font-semibold">No. Surat</th>
            <th class="px-5 py-3.5 font-semibold">Perihal</th>
            <th class="px-5 py-3.5 font-semibold">Diteruskan Ke</th>
            <th class="px-5 py-3.5 font-semibold">Prioritas</th>
            <th class="px-5 py-3.5 font-semibold">Status</th>
            <th class="px-5 py-3.5 font-semibold">Tanggal</th>
            <th class="px-5 py-3.5 font-semibold text-center">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (disposisi.length === 0) { %>
          <tr>
            <td colspan="7" class="px-5 py-16 text-center">
              <div class="text-5xl text-slate-200 mb-4"><i class="fas fa-share-nodes"></i></div>
              <p class="text-slate-400 font-medium">Belum ada data disposisi</p>
              <p class="text-slate-400 text-xs mt-1">Buat disposisi dari halaman detail surat masuk</p>
            </td>
          </tr>
          <% } %>

          <% disposisi.forEach(d => { %>
          <tr class="hover:bg-slate-50 transition">
            <td class="px-5 py-3.5 font-mono font-semibold text-bpn-700"><%= d.nomor_surat || '-' %></td>
            <td class="px-5 py-3.5 text-slate-600 max-w-[220px] truncate">
              <span class="font-medium text-slate-700"><%= d.perihal || '-' %></span>
              <span class="block text-[10px] text-slate-400 mt-0.5"><%= d.tipe_surat === 'masuk' ? 'Surat Masuk' : 'Surat Keluar' %></span>
            </td>
            <td class="px-5 py-3.5 text-slate-700"><%= d.diteruskan_ke %></td>
            <td class="px-5 py-3.5">
              <span class="text-[10px] px-2.5 py-1 rounded-full font-semibold
                <%= d.prioritas === 'Segera' ? 'bg-red-50 text-red-600' : d.prioritas === 'Penting' ? 'bg-amber-50 text-amber-600' : 'bg-slate-100 text-slate-500' %>">
                <%= d.prioritas %>
              </span>
            </td>
            <td class="px-5 py-3.5">
              <span class="text-[10px] px-2.5 py-1 rounded-full font-semibold
                <%= d.status === 'Selesai' ? 'bg-emerald-50 text-emerald-600' : d.status === 'Diproses' ? 'bg-blue-50 text-bpn-600' : 'bg-slate-100 text-slate-500' %>">
                <%= d.status %>
              </span>
            </td>
            <td class="px-5 py-3.5 text-slate-500 text-xs"><%= new Date(d.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
            <td class="px-5 py-3.5">
              <div class="flex items-center justify-center gap-1">
                <form method="POST" action="/disposisi/<%= d.id %>/status" class="inline">
                  <select name="status" onchange="this.form.submit()" class="text-xs border border-slate-200 rounded-lg px-2 py-1.5 focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
                    <option value="Menunggu" <%= d.status === 'Menunggu' ? 'selected' : '' %>>Menunggu</option>
                    <option value="Diproses" <%= d.status === 'Diproses' ? 'selected' : '' %>>Diproses</option>
                    <option value="Selesai" <%= d.status === 'Selesai' ? 'selected' : '' %>>Selesai</option>
                  </select>
                </form>
                <form method="POST" action="/disposisi/<%= d.id %>/delete" class="inline" onsubmit="return confirm('Yakin ingin menghapus disposisi ini?')">
                  <button type="submit" class="p-2 rounded-lg text-red-500 hover:bg-red-50 transition" title="Hapus">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="px-5 py-3 border-t border-slate-100 text-xs text-slate-500">
      <span>Menampilkan <strong class="text-slate-700"><%= disposisi.length %></strong> disposisi</span>
    </div>
  </div>
</div>