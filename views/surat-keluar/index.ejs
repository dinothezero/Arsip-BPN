<div class="max-w-7xl mx-auto">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Surat Keluar</h1>
      <p class="text-slate-500 text-sm mt-1">Kelola dan pantau seluruh surat keluar</p>
    </div>
    <a href="/surat-keluar/create" class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2.5 rounded-xl shadow-lg shadow-emerald-600/25 transition-all hover:shadow-xl hover:-translate-y-0.5">
      <i class="fas fa-plus mr-2"></i>Tambah Surat Keluar
    </a>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-5 border-b border-slate-100">
      <form method="GET" class="flex flex-wrap gap-3 items-end">
        <div class="flex-1 min-w-[200px]">
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Cari</label>
          <div class="relative">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input type="text" name="q" value="<%= filters.q || '' %>" placeholder="Cari nomor, perihal, tujuan..."
              class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 focus:border-bpn-500 outline-none transition">
          </div>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Status</label>
          <select name="status" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
            <option value="">Semua Status</option>
            <% statusList.forEach(s => { %>
              <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Kategori</label>
          <select name="kategori" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
            <option value="">Semua Kategori</option>
            <% kategoriList.forEach(k => { %>
              <option value="<%= k.id %>" <%= String(filters.kategori) === String(k.id) ? 'selected' : '' %>><%= k.nama_kategori %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Dari</label>
          <input type="date" name="dari" value="<%= filters.dari || '' %>" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none">
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Sampai</label>
          <input type="date" name="sampai" value="<%= filters.sampai || '' %>" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none">
        </div>
        <div class="flex gap-2">
          <button type="submit" class="px-4 py-2 bg-bpn-600 hover:bg-bpn-700 text-white rounded-xl text-sm font-medium transition">
            <i class="fas fa-filter mr-1"></i>Filter
          </button>
          <a href="/surat-keluar" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-sm font-medium transition">
            <i class="fas fa-rotate-left mr-1"></i>Reset
          </a>
        </div>
      </form>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-slate-50 text-left text-[11px] uppercase tracking-wider text-slate-500">
            <th class="px-5 py-3.5 font-semibold">No. Surat</th>
            <th class="px-5 py-3.5 font-semibold">Tanggal</th>
            <th class="px-5 py-3.5 font-semibold">Tujuan</th>
            <th class="px-5 py-3.5 font-semibold">Perihal</th>
            <th class="px-5 py-3.5 font-semibold">Status</th>
            <th class="px-5 py-3.5 font-semibold text-center">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (surat.length === 0) { %>
          <tr>
            <td colspan="6" class="px-5 py-16 text-center">
              <div class="text-5xl text-slate-200 mb-4"><i class="fas fa-paper-plane"></i></div>
              <p class="text-slate-400 font-medium">Belum ada data surat keluar</p>
            </td>
          </tr>
          <% } %>

          <% surat.forEach(s => { %>
          <tr class="hover:bg-slate-50 transition">
            <td class="px-5 py-3.5">
              <a href="/surat-keluar/<%= s.id %>" class="font-semibold text-emerald-700 hover:text-emerald-900 hover:underline"><%= s.nomor_surat %></a>
            </td>
            <td class="px-5 py-3.5 text-slate-600 whitespace-nowrap"><%= formatTanggalShort(s.tanggal_surat) %></td>
            <td class="px-5 py-3.5 text-slate-700 max-w-[180px] truncate"><%= s.tujuan %></td>
            <td class="px-5 py-3.5 text-slate-600 max-w-[250px] truncate">
              <span class="font-medium"><%= s.perihal %></span>
              <% if (s.lampiran) { %><span class="text-[10px] text-amber-600 ml-1"><i class="fas fa-paperclip"></i></span><% } %>
            </td>
            <td class="px-5 py-3.5">
              <span class="text-xs px-2.5 py-1 rounded-full font-semibold
                <%= s.status === 'Draft' ? 'bg-slate-100 text-slate-600' :
                   s.status === 'Disetujui' ? 'bg-blue-50 text-bpn-600' :
                   s.status === 'Dikirim' ? 'bg-amber-50 text-amber-600' :
                   'bg-emerald-50 text-emerald-600' %>">
                <%= s.status %>
              </span>
            </td>
            <td class="px-5 py-3.5">
              <div class="flex items-center justify-center gap-1">
                <a href="/surat-keluar/<%= s.id %>" class="p-2 rounded-lg text-emerald-600 hover:bg-emerald-50 transition" title="Detail">
                  <i class="fas fa-eye"></i>
                </a>
                <a href="/surat-keluar/<%= s.id %>/edit" class="p-2 rounded-lg text-amber-600 hover:bg-amber-50 transition" title="Edit">
                  <i class="fas fa-pen"></i>
                </a>
                <form method="POST" action="/surat-keluar/<%= s.id %>/delete" class="inline" onsubmit="return confirm('Yakin ingin menghapus surat ini?')">
                  <button type="submit" class="p-2 rounded-lg text-red-500 hover:bg-red-50 transition" title="Hapus">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="px-5 py-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
      <span>Menampilkan <strong class="text-slate-700"><%= surat.length %></strong> surat keluar</span>
    </div>
  </div>
</div>