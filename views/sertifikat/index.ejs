<div class="max-w-7xl mx-auto">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Sertifikat Tanah</h1>
      <p class="text-slate-500 text-sm mt-1">Data dan arsip sertifikat tanah</p>
    </div>
    <a href="/sertifikat/create" class="bg-violet-600 hover:bg-violet-700 text-white text-sm font-medium px-4 py-2.5 rounded-xl shadow-lg shadow-violet-600/25 transition-all hover:shadow-xl hover:-translate-y-0.5">
      <i class="fas fa-plus mr-2"></i>Tambah Sertifikat
    </a>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-5 border-b border-slate-100">
      <form method="GET" class="flex flex-wrap gap-3 items-end">
        <div class="flex-1 min-w-[200px]">
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Cari</label>
          <div class="relative">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input type="text" name="q" value="<%= filters.q || '' %>" placeholder="Cari nomor, pemilik, NIK, lokasi..."
              class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 focus:border-bpn-500 outline-none transition">
          </div>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Jenis</label>
          <select name="jenis" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
            <option value="">Semua Jenis</option>
            <% jenisList.forEach(j => { %>
              <option value="<%= j %>" <%= filters.jenis === j ? 'selected' : '' %>><%= j %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Status</label>
          <select name="status" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
            <option value="">Semua Status</option>
            <% statusList.forEach(s => { %>
              <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Kecamatan</label>
          <select name="kecamatan" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
            <option value="">Semua Kecamatan</option>
            <% kecamatanList.forEach(k => { %>
              <option value="<%= k.kecamatan %>" <%= filters.kecamatan === k.kecamatan ? 'selected' : '' %>><%= k.kecamatan %></option>
            <% }) %>
          </select>
        </div>
        <div class="flex gap-2">
          <button type="submit" class="px-4 py-2 bg-bpn-600 hover:bg-bpn-700 text-white rounded-xl text-sm font-medium transition">
            <i class="fas fa-filter mr-1"></i>Filter
          </button>
          <a href="/sertifikat" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-sm font-medium transition">
            <i class="fas fa-rotate-left mr-1"></i>Reset
          </a>
        </div>
      </form>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 p-5">
      <% if (sertifikat.length === 0) { %>
      <div class="md:col-span-2 xl:col-span-3 py-16 text-center">
        <div class="text-5xl text-slate-200 mb-4"><i class="fas fa-file-contract"></i></div>
        <p class="text-slate-400 font-medium">Belum ada data sertifikat</p>
      </div>
      <% } %>

      <% sertifikat.forEach(s => { %>
      <a href="/sertifikat/<%= s.id %>" class="bg-slate-50 rounded-2xl border border-slate-200 p-5 hover:border-violet-300 hover:shadow-lg transition-all group">
        <div class="flex items-start justify-between mb-3">
          <div class="w-11 h-11 rounded-xl bg-violet-100 text-violet-600 flex items-center justify-center group-hover:bg-violet-600 group-hover:text-white transition">
            <i class="fas fa-file-contract text-lg"></i>
          </div>
          <span class="text-[10px] px-2.5 py-1 rounded-full font-semibold
            <%= s.status_sertifikat === 'Aktif' ? 'bg-emerald-50 text-emerald-600' :
               s.status_sertifikat === 'Blokir' ? 'bg-red-50 text-red-600' :
               s.status_sertifikat === 'Sengketa' ? 'bg-amber-50 text-amber-600' :
               s.status_sertifikat === 'Batal' ? 'bg-slate-100 text-slate-500' :
               'bg-orange-50 text-orange-600' %>">
            <%= s.status_sertifikat %>
          </span>
        </div>

        <p class="font-mono text-sm font-bold text-slate-800 group-hover:text-violet-700 transition">
          <%= s.nomor_sertifikat %>
        </p>
        <p class="text-sm font-medium text-slate-600 mt-2"><i class="fas fa-user text-slate-400 mr-1.5"></i><%= s.nama_pemilik %></p>
        <p class="text-xs text-slate-400 mt-1 truncate"><i class="fas fa-map-location-dot mr-1.5"></i><%= s.letak_tanah %></p>

        <div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-200 text-xs">
          <span class="px-2 py-0.5 rounded-md bg-violet-50 text-violet-700 font-medium"><%= s.jenis_sertifikat %></span>
          <span class="text-slate-500 font-medium">
            <%= s.luas_tanah ? Number(s.luas_tanah).toLocaleString('id-ID') + ' ' + s.satuan_luas : '-' %>
          </span>
        </div>
      </a>
      <% }) %>
    </div>

    <div class="px-5 py-3 border-t border-slate-100 text-xs text-slate-500">
      <span>Menampilkan <strong class="text-slate-700"><%= sertifikat.length %></strong> sertifikat</span>
    </div>
  </div>
</div>