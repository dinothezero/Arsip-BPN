<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <a href="/sertifikat" class="text-sm text-slate-500 hover:text-violet-600 transition mb-1 inline-flex items-center gap-2">
        <i class="fas fa-arrow-left text-xs"></i> Kembali
      </a>
      <h1 class="text-2xl font-bold text-slate-800 mt-1">Edit Sertifikat</h1>
    </div>
  </div>

  <form method="POST" action="/sertifikat/<%= sertifikat.id %>/edit" enctype="multipart/form-data" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <input type="hidden" name="existing_file" value="<%= sertifikat.file_sertifikat || '' %>">

    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Nomor Sertifikat <span class="text-red-500">*</span></label>
        <input type="text" name="nomor_sertifikat" value="<%= sertifikat.nomor_sertifikat %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none transition font-mono" required>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Jenis Sertifikat <span class="text-red-500">*</span></label>
        <select name="jenis_sertifikat" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none bg-white" required>
          <% ['Hak Milik','Hak Guna Bangunan','Hak Pakai','Tanah Negara','Tanah Wakaf','Lainnya'].forEach(j => { %>
            <option value="<%= j %>" <%= sertifikat.jenis_sertifikat === j ? 'selected' : '' %>><%= j %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Nama Pemilik <span class="text-red-500">*</span></label>
        <input type="text" name="nama_pemilik" value="<%= sertifikat.nama_pemilik %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none transition" required>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">NIK Pemilik</label>
        <input type="text" name="nik_pemilik" value="<%= sertifikat.nik_pemilik || '' %>" maxlength="16" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none transition">
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Alamat Pemilik</label>
        <textarea name="alamat_pemilik" rows="2" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none transition resize-y"><%= sertifikat.alamat_pemilik || '' %></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Luas Tanah</label>
        <div class="flex gap-2">
          <input type="number" name="luas_tanah" step="0.01" min="0" value="<%= sertifikat.luas_tanah || '' %>" class="flex-1 px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none transition">
          <select name="satuan_luas" class="px-3 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none bg-white">
            <option value="m2" <%= sertifikat.satuan_luas === 'm2' ? 'selected' : '' %>>m²</option>
            <option value="ha" <%= sertifikat.satuan_luas === 'ha' ? 'selected' : '' %>>Ha</option>
          </select>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Tanggal Terbit</label>
        <input type="date" name="tanggal_terbit" value="<%= sertifikat.tanggal_terbit || '' %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none">
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Letak / Lokasi Tanah <span class="text-red-500">*</span></label>
        <input type="text" name="letak_tanah" value="<%= sertifikat.letak_tanah %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none transition" required>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Kelurahan</label>
        <input type="text" name="kelurahan" value="<%= sertifikat.kelurahan || '' %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Kecamatan</label>
        <input type="text" name="kecamatan" value="<%= sertifikat.kecamatan || '' %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Kabupaten</label>
        <input type="text" name="kabupaten" value="<%= sertifikat.kabupaten || '' %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Provinsi</label>
        <input type="text" name="provinsi" value="<%= sertifikat.provinsi || '' %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Nomor Petak</label>
        <input type="text" name="nomor_petak" value="<%= sertifikat.nomor_petak || '' %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Letter C</label>
        <input type="text" name="letter_c" value="<%= sertifikat.letter_c || '' %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Status Sertifikat</label>
        <select name="status_sertifikat" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none bg-white">
          <% ['Aktif','Blokir','Sengketa','Batal','Expired'].forEach(s => { %>
            <option value="<%= s %>" <%= sertifikat.status_sertifikat === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Keterangan</label>
        <input type="text" name="keterangan" value="<%= sertifikat.keterangan || '' %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-violet-500 outline-none transition">
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Upload File Baru</label>
        <input type="file" name="file_sertifikat" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" class="w-full text-sm text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-violet-50 file:text-violet-700 hover:file:bg-violet-100">
        <% if (sertifikat.file_sertifikat) { %>
          <p class="text-[11px] text-emerald-600 mt-1"><i class="fas fa-file mr-1"></i>File saat ini: <%= sertifikat.file_sertifikat %></p>
        <% } %>
      </div>
    </div>

    <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-3">
      <a href="/sertifikat/<%= sertifikat.id %>" class="px-5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-200 transition">Batal</a>
      <button type="submit" class="px-6 py-2.5 bg-violet-600 hover:bg-violet-700 text-white rounded-xl text-sm font-semibold shadow-lg shadow-violet-600/25 transition-all hover:shadow-xl">
        <i class="fas fa-save mr-2"></i>Simpan Perubahan
      </button>
    </div>
  </form>
</div>