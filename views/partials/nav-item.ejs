<a href="<%= href %>"
   class="<%= currentPath === href || currentPath.startsWith(href + '/') ? 'bg-gradient-to-r from-bpn-600 to-bpn-700 text-white shadow-lg shadow-bpn-900/40' : 'text-slate-300 hover:bg-white/10 hover:text-white' %> flex items-center gap-3 mx-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all mb-0.5 group">
  <i class="fas <%= icon %> w-5 text-center text-lg <%= currentPath === href || currentPath.startsWith(href + '/') ? '' : 'text-slate-500 group-hover:text-bpn-400' %> transition"></i>
  <span class="flex-1"><%= label %></span>
  <i class="fas fa-chevron-right text-[10px] opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all"></i>
</a>