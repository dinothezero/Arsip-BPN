<header class="fixed top-0 left-64 right-0 h-16 bg-white border-b border-slate-200 z-30 flex items-center justify-between px-6">
  <div class="flex items-center gap-4">
    <button id="sidebarToggle" class="lg:hidden text-slate-500 hover:text-slate-800 transition p-2 -ml-2">
      <i class="fas fa-bars text-lg"></i>
    </button>
    <div>
      <h2 class="font-semibold text-slate-800 text-sm">
        <%= title.split(' - ')[0] %>
      </h2>
      <p class="text-[11px] text-slate-400">
        <%= new Date().toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
      </p>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <a href="/dashboard" class="text-slate-400 hover:text-bpn-600 transition p-2 hover:bg-slate-100 rounded-lg" title="Refresh">
      <i class="fas fa-rotate-right"></i>
    </a>

    <div class="relative" id="notifWrap">
      <button id="notifBtn" class="text-slate-400 hover:text-bpn-600 transition p-2 hover:bg-slate-100 rounded-lg relative" title="Notifikasi">
        <i class="fas fa-bell"></i>
      </button>
    </div>

    <div class="h-8 w-px bg-slate-200"></div>

    <a href="/pengaturan" class="flex items-center gap-2.5 p-1.5 pr-3 hover:bg-slate-100 rounded-xl transition group">
      <div class="w-8 h-8 rounded-full bg-gradient-to-br from-bpn-500 to-bpn-700 flex items-center justify-center text-xs font-bold text-white shrink-0">
        <%= user.nama_lengkap.charAt(0).toUpperCase() %>
      </div>
      <div class="hidden md:block text-left leading-tight">
        <p class="text-xs font-semibold text-slate-700 group-hover:text-bpn-700 transition"><%= user.nama_lengkap %></p>
        <p class="text-[10px] text-slate-400 capitalize"><%= user.role %></p>
      </div>
      <i class="fas fa-caret-down text-xs text-slate-400 hidden md:block"></i>
    </a>
  </div>
</header>