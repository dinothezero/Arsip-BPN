<aside id="sidebar" class="fixed top-0 left-0 h-full w-64 bg-gradient-to-b from-slate-900 to-slate-800 text-white z-40 transition-all duration-300 flex flex-col">
  <div class="flex items-center gap-3 px-5 py-5 border-b border-white/10">
    <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-bpn-500 to-bpn-700 flex items-center justify-center shadow-lg shadow-bpn-900/50 shrink-0">
      <i class="fas fa-landmark text-white text-xl"></i>
    </div>
    <div class="min-w-0">
      <h1 class="font-bold text-sm leading-tight truncate">Arsip BPN</h1>
      <p class="text-[11px] text-slate-400 truncate">Arsip Digital Pertanahan</p>
    </div>
  </div>

  <nav class="flex-1 overflow-y-auto py-4 sidebar-scroll">
    <div class="px-4 pb-2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Menu Utama</div>

    <%- include('nav-item', { href: '/dashboard', icon: 'fa-gauge-high', label: 'Dashboard' }) %>
    <%- include('nav-item', { href: '/surat-masuk', icon: 'fa-inbox', label: 'Surat Masuk' }) %>
    <%- include('nav-item', { href: '/surat-keluar', icon: 'fa-paper-plane', label: 'Surat Keluar' }) %>
    <%- include('nav-item', { href: '/disposisi', icon: 'fa-share-nodes', label: 'Disposisi Surat' }) %>
    <%- include('nav-item', { href: '/arsip', icon: 'fa-box-archive', label: 'Arsip Dokumen' }) %>
    <%- include('nav-item', { href: '/sertifikat', icon: 'fa-file-contract', label: 'Sertifikat Tanah' }) %>
    <%- include('nav-item', { href: '/laporan', icon: 'fa-chart-column', label: 'Laporan' }) %>

    <% if (user.role === 'admin') { %>
      <div class="px-4 pt-5 pb-2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Administrasi</div>
      <%- include('nav-item', { href: '/logs', icon: 'fa-clock-rotate-left', label: 'Log Aktivitas' }) %>
      <%- include('nav-item', { href: '/pengaturan', icon: 'fa-gear', label: 'Pengaturan' }) %>
    <% } %>
  </nav>

  <div class="p-4 border-t border-white/10">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center text-sm font-bold text-white shrink-0">
        <%= user.nama_lengkap.charAt(0).toUpperCase() %>
      </div>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-medium truncate"><%= user.nama_lengkap %></p>
        <p class="text-[11px] text-slate-400 truncate">
          <span class="capitalize"><%= user.role %></span> · <%= user.jabatan %>
        </p>
      </div>
      <a href="/logout" title="Keluar" class="text-slate-400 hover:text-red-400 transition p-2">
        <i class="fas fa-right-from-bracket"></i>
      </a>
    </div>
  </div>
</aside>