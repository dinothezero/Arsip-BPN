<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <a href="/arsip" class="text-sm text-slate-500 hover:text-bpn-600 transition mb-1 inline-flex items-center gap-2">
        <i class="fas fa-arrow-left text-xs"></i> Kembali
      </a>
      <h1 class="text-2xl font-bold text-slate-800 mt-1">Tambah Arsip</h1>
      <p class="text-slate-500 text-sm mt-1">Registrasi arsip dokumen baru</p>
    </div>
  </div>

  <form method="POST" action="/arsip/create" enctype="multipart/form-data" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="border-b border-slate-100 px-6 py-4 bg-slate-50">
      <h3 class="font-semibold text-slate-700"><i class="fas fa-box-archive text-slate-600 mr-2"></i>Informasi Arsip</h3>
    </div>

    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Kode Arsip <span class="text-red-500">*</span></label>
        <div class="flex gap-2">
          <input type="text" name="kode_arsip" id="kodeArsip" value="<%= kodeSaran %>" class="flex-1 px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition font-mono" required>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Kategori <span class="text-red-500">*</span></label>
        <select name="kategori" id="kategoriArsip" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white" required>
          <option value="">-- Pilih Kategori --</option>
          <% kategoriList.forEach(k => { %>
            <option value="<%= k %>"><%= k %></option>
          <% }) %>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Judul Arsip <span class="text-red-500">*</span></label>
        <input type="text" name="judul" placeholder="Judul / nama dokumen arsip" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition" required>
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Deskripsi</label>
        <textarea name="deskripsi" rows="3" placeholder="Deskripsi singkat isi arsip..." class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition resize-y"></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Sub Kategori</label>
        <input type="text" name="sub_kategori" placeholder="Contoh: Buku Tanah Hak Milik" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Tahun</label>
        <input type="number" name="tahun" value="<%= new Date().getFullYear() %>" min="1900" max="2100" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Lokasi Rak</label>
        <input type="text" name="lokasi_rak" placeholder="Contoh: Rak 3 / Lantai 2" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Lokasi Box</label>
        <input type="text" name="lokasi_box" placeholder="Contoh: Box B-07" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Status</label>
        <select name="status" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
          <option value="Aktif" selected>Aktif</option>
          <option value="Arsip">Arsip</option>
          <option value="Rusak">Rusak</option>
          <option value="Hilang">Hilang</option>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Upload File Dokumen</label>
        <div class="relative">
          <input type="file" name="file_dokumen" id="fileInput" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.zip,.rar" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
          <div id="fileDrop" class="border-2 border-dashed border-slate-300 rounded-xl p-4 text-center hover:border-bpn-500 hover:bg-bpn-50 transition cursor-pointer">
            <i class="fas fa-cloud-arrow-up text-slate-400 text-xl mb-1 block"></i>
            <p class="text-xs text-slate-500 font-medium" id="fileName">Klik untuk upload file (PDF, DOC, ZIP)</p>
            <p class="text-[10px] text-slate-400 mt-0.5">Maksimal 20MB</p>
          </div>
        </div>
      </div>
    </div>

    <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-3">
      <a href="/arsip" class="px-5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-200 transition">Batal</a>
      <button type="submit" class="px-6 py-2.5 bg-slate-700 hover:bg-slate-800 text-white rounded-xl text-sm font-semibold shadow-lg shadow-slate-700/25 transition-all hover:shadow-xl">
        <i class="fas fa-save mr-2"></i>Simpan Arsip
      </button>
    </div>
  </form>
</div>

<script>
  document.getElementById('fileInput').addEventListener('change', function() {
    if (this.files.length > 0) {
      document.getElementById('fileName').textContent = this.files[0].name;
    }
  });

  document.getElementById('kategoriArsip').addEventListener('change', async function() {
    if (!this.value) return;
    const res = await fetch(`/arsip/generate-kode?kategori=${encodeURIComponent(this.value)}`);
    const data = await res.json();
    document.getElementById('kodeArsip').value = data.kode;
  });
</script>