<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <a href="/arsip" class="text-sm text-slate-500 hover:text-bpn-600 transition mb-1 inline-flex items-center gap-2">
        <i class="fas fa-arrow-left text-xs"></i> Kembali
      </a>
      <h1 class="text-2xl font-bold text-slate-800 mt-1">Edit Arsip</h1>
    </div>
  </div>

  <form method="POST" action="/arsip/<%= arsip.id %>/edit" enctype="multipart/form-data" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <input type="hidden" name="existing_file" value="<%= arsip.file_dokumen || '' %>">

    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Kode Arsip <span class="text-red-500">*</span></label>
        <input type="text" name="kode_arsip" value="<%= arsip.kode_arsip %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition font-mono" required>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Kategori <span class="text-red-500">*</span></label>
        <select name="kategori" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white" required>
          <% kategoriList.forEach(k => { %>
            <option value="<%= k %>" <%= arsip.kategori === k ? 'selected' : '' %>><%= k %></option>
          <% }) %>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Judul Arsip <span class="text-red-500">*</span></label>
        <input type="text" name="judul" value="<%= arsip.judul %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition" required>
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Deskripsi</label>
        <textarea name="deskripsi" rows="3" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition resize-y"><%= arsip.deskripsi || '' %></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Sub Kategori</label>
        <input type="text" name="sub_kategori" value="<%= arsip.sub_kategori || '' %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Tahun</label>
        <input type="number" name="tahun" value="<%= arsip.tahun || new Date().getFullYear() %>" min="1900" max="2100" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Lokasi Rak</label>
        <input type="text" name="lokasi_rak" value="<%= arsip.lokasi_rak || '' %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Lokasi Box</label>
        <input type="text" name="lokasi_box" value="<%= arsip.lokasi_box || '' %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Status</label>
        <select name="status" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
          <% ['Aktif','Arsip','Rusak','Hilang'].forEach(s => { %>
            <option value="<%= s %>" <%= arsip.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Upload File Baru</label>
        <input type="file" name="file_dokumen" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.zip,.rar" class="w-full text-sm text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200">
        <% if (arsip.file_dokumen) { %>
          <p class="text-[11px] text-emerald-600 mt-1"><i class="fas fa-file mr-1"></i>File saat ini: <%= arsip.file_dokumen %></p>
        <% } %>
      </div>
    </div>

    <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-3">
      <a href="/arsip/<%= arsip.id %>" class="px-5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-200 transition">Batal</a>
      <button type="submit" class="px-6 py-2.5 bg-slate-700 hover:bg-slate-800 text-white rounded-xl text-sm font-semibold shadow-lg shadow-slate-700/25 transition-all hover:shadow-xl">
        <i class="fas fa-save mr-2"></i>Simpan Perubahan
      </button>
    </div>
  </form>
</div>