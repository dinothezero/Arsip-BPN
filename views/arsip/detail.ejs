<div class="max-w-5xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <a href="/arsip" class="text-sm text-slate-500 hover:text-bpn-600 transition mb-1 inline-flex items-center gap-2">
        <i class="fas fa-arrow-left text-xs"></i> Kembali
      </a>
      <h1 class="text-2xl font-bold text-slate-800 mt-1">Detail Arsip</h1>
    </div>
    <div class="flex gap-2">
      <a href="/arsip/<%= arsip.id %>/edit" class="px-4 py-2.5 bg-amber-500 hover:bg-amber-600 text-white rounded-xl text-sm font-medium transition shadow-lg shadow-amber-500/25">
        <i class="fas fa-pen mr-1"></i>Edit
      </a>
      <% if (arsip.file_dokumen) { %>
        <a href="/uploads/arsip/<%= arsip.file_dokumen %>" target="_blank" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-medium transition">
          <i class="fas fa-download mr-1"></i>Unduh
        </a>
      <% } %>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="px-6 py-4 bg-gradient-to-r from-slate-700 to-slate-800 flex items-center justify-between">
      <h3 class="font-semibold text-white"><i class="fas fa-box-archive mr-2"></i>Detail Arsip</h3>
      <span class="text-xs px-3 py-1 rounded-full bg-white/20 text-white font-mono font-semibold"><%= arsip.kode_arsip %></span>
    </div>

    <div class="p-6">
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="bg-slate-50 rounded-xl p-4 sm:col-span-2">
          <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Judul</p>
          <p class="text-base font-semibold text-slate-800 mt-1"><%= arsip.judul %></p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Kategori</p>
          <p class="text-sm font-semibold text-slate-800 mt-1">
            <span class="text-xs px-2.5 py-1 rounded-lg bg-blue-50 text-bpn-600 font-medium"><%= arsip.kategori %></span>
          </p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Sub Kategori</p>
          <p class="text-sm font-semibold text-slate-800 mt-1"><%= arsip.sub_kategori || '-' %></p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Tahun</p>
          <p class="text-sm font-semibold text-slate-800 mt-1"><%= arsip.tahun || '-' %></p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Status</p>
          <p class="text-sm font-semibold text-slate-800 mt-1">
            <span class="text-xs px-2.5 py-1 rounded-full font-semibold
              <%= arsip.status === 'Aktif' ? 'bg-emerald-50 text-emerald-600' :
                 arsip.status === 'Arsip' ? 'bg-slate-100 text-slate-600' :
                 arsip.status === 'Rusak' ? 'bg-amber-50 text-amber-600' :
                 'bg-red-50 text-red-600' %>">
              <%= arsip.status %>
            </span>
          </p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Lokasi Rak</p>
          <p class="text-sm font-semibold text-slate-800 mt-1"><i class="fas fa-warehouse text-slate-400 mr-1"></i><%= arsip.lokasi_rak || '-' %></p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Lokasi Box</p>
          <p class="text-sm font-semibold text-slate-800 mt-1"><i class="fas fa-box text-slate-400 mr-1"></i><%= arsip.lokasi_box || '-' %></p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Diinput Oleh</p>
          <p class="text-sm font-semibold text-slate-800 mt-1"><%= arsip.nama_operator || '-' %></p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Tanggal Masuk Sistem</p>
          <p class="text-sm font-semibold text-slate-800 mt-1"><%= new Date(arsip.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
        </div>
      </div>

      <% if (arsip.deskripsi) { %>
      <div class="mt-5">
        <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide mb-1">Deskripsi</p>
        <p class="text-sm text-slate-600 bg-slate-50 rounded-xl p-4"><%= arsip.deskripsi %></p>
      </div>
      <% } %>

      <% if (arsip.file_dokumen) { %>
      <div class="mt-5 flex items-center justify-between bg-emerald-50 border border-emerald-200 rounded-xl p-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center">
            <i class="fas fa-file"></i>
          </div>
          <div>
            <p class="text-sm font-semibold text-emerald-800">File Dokumen</p>
            <p class="text-xs text-emerald-600"><%= arsip.file_dokumen %></p>
          </div>
        </div>
        <a href="/uploads/arsip/<%= arsip.file_dokumen %>" target="_blank" class="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-medium transition">
          <i class="fas fa-download mr-1"></i>Unduh
        </a>
      </div>
      <% } %>
    </div>

    <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-between items-center">
      <span class="text-xs text-slate-400">Dibuat: <%= new Date(arsip.created_at).toLocaleString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
      <form method="POST" action="/arsip/<%= arsip.id %>/delete" onsubmit="return confirm('Yakin ingin menghapus arsip ini?')">
        <button type="submit" class="text-red-500 hover:text-red-700 text-xs font-medium inline-flex items-center gap-1">
          <i class="fas fa-trash text-xs"></i> Hapus Arsip
        </button>
      </form>
    </div>
  </div>
</div>