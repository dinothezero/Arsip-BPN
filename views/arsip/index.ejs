<div class="max-w-7xl mx-auto">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Arsip Dokumen</h1>
      <p class="text-slate-500 text-sm mt-1">Pengelolaan arsip fisik &amp; digital kantor</p>
    </div>
    <a href="/arsip/create" class="bg-slate-700 hover:bg-slate-800 text-white text-sm font-medium px-4 py-2.5 rounded-xl shadow-lg shadow-slate-700/25 transition-all hover:shadow-xl hover:-translate-y-0.5">
      <i class="fas fa-plus mr-2"></i>Tambah Arsip
    </a>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-5 border-b border-slate-100">
      <form method="GET" class="flex flex-wrap gap-3 items-end">
        <div class="flex-1 min-w-[200px]">
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Cari</label>
          <div class="relative">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input type="text" name="q" value="<%= filters.q || '' %>" placeholder="Cari kode, judul, lokasi rak..."
              class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 focus:border-bpn-500 outline-none transition">
          </div>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Kategori</label>
          <select name="kategori" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
            <option value="">Semua Kategori</option>
            <% kategoriList.forEach(k => { %>
              <option value="<%= k %>" <%= filters.kategori === k ? 'selected' : '' %>><%= k %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Status</label>
          <select name="status" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
            <option value="">Semua Status</option>
            <% statusList.forEach(s => { %>
              <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Tahun</label>
          <select name="tahun" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
            <option value="">Semua Tahun</option>
            <% tahunList.forEach(t => { %>
              <option value="<%= t.tahun %>" <%= String(filters.tahun) === String(t.tahun) ? 'selected' : '' %>><%= t.tahun %></option>
            <% }) %>
          </select>
        </div>
        <div class="flex gap-2">
          <button type="submit" class="px-4 py-2 bg-bpn-600 hover:bg-bpn-700 text-white rounded-xl text-sm font-medium transition">
            <i class="fas fa-filter mr-1"></i>Filter
          </button>
          <a href="/arsip" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-sm font-medium transition">
            <i class="fas fa-rotate-left mr-1"></i>Reset
          </a>
        </div>
      </form>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-slate-50 text-left text-[11px] uppercase tracking-wider text-slate-500">
            <th class="px-5 py-3.5 font-semibold">Kode Arsip</th>
            <th class="px-5 py-3.5 font-semibold">Judul</th>
            <th class="px-5 py-3.5 font-semibold">Kategori</th>
            <th class="px-5 py-3.5 font-semibold">Lokasi</th>
            <th class="px-5 py-3.5 font-semibold">Tahun</th>
            <th class="px-5 py-3.5 font-semibold">Status</th>
            <th class="px-5 py-3.5 font-semibold text-center">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (arsip.length === 0) { %>
          <tr>
            <td colspan="7" class="px-5 py-16 text-center">
              <div class="text-5xl text-slate-200 mb-4"><i class="fas fa-box-archive"></i></div>
              <p class="text-slate-400 font-medium">Belum ada data arsip</p>
            </td>
          </tr>
          <% } %>

          <% arsip.forEach(a => { %>
          <tr class="hover:bg-slate-50 transition">
            <td class="px-5 py-3.5">
              <a href="/arsip/<%= a.id %>" class="font-mono font-semibold text-bpn-700 hover:text-bpn-900 hover:underline"><%= a.kode_arsip %></a>
            </td>
            <td class="px-5 py-3.5 text-slate-600 max-w-[250px] truncate">
              <span class="font-medium"><%= a.judul %></span>
              <% if (a.file_dokumen) { %><span class="text-[10px] text-emerald-600 ml-1"><i class="fas fa-file"></i></span><% } %>
            </td>
            <td class="px-5 py-3.5">
              <span class="text-xs px-2.5 py-1 rounded-lg bg-blue-50 text-bpn-600 font-medium"><%= a.kategori %></span>
            </td>
            <td class="px-5 py-3.5 text-slate-600 whitespace-nowrap">
              <% if (a.lokasi_rak) { %><span class="text-xs"><i class="fas fa-warehouse text-slate-400 mr-1"></i>Rak <%= a.lokasi_rak %></span><% } %>
              <% if (a.lokasi_box) { %><span class="text-xs ml-1"><i class="fas fa-box text-slate-400 mr-1"></i>Box <%= a.lokasi_box %></span><% } %>
            </td>
            <td class="px-5 py-3.5 text-slate-500"><%= a.tahun || '-' %></td>
            <td class="px-5 py-3.5">
              <span class="text-xs px-2.5 py-1 rounded-full font-semibold
                <%= a.status === 'Aktif' ? 'bg-emerald-50 text-emerald-600' :
                   a.status === 'Arsip' ? 'bg-slate-100 text-slate-600' :
                   a.status === 'Rusak' ? 'bg-amber-50 text-amber-600' :
                   'bg-red-50 text-red-600' %>">
                <%= a.status %>
              </span>
            </td>
            <td class="px-5 py-3.5">
              <div class="flex items-center justify-center gap-1">
                <a href="/arsip/<%= a.id %>" class="p-2 rounded-lg text-bpn-600 hover:bg-bpn-50 transition" title="Detail">
                  <i class="fas fa-eye"></i>
                </a>
                <a href="/arsip/<%= a.id %>/edit" class="p-2 rounded-lg text-amber-600 hover:bg-amber-50 transition" title="Edit">
                  <i class="fas fa-pen"></i>
                </a>
                <form method="POST" action="/arsip/<%= a.id %>/delete" class="inline" onsubmit="return confirm('Yakin ingin menghapus arsip ini?')">
                  <button type="submit" class="p-2 rounded-lg text-red-500 hover:bg-red-50 transition" title="Hapus">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="px-5 py-3 border-t border-slate-100 text-xs text-slate-500">
      <span>Menampilkan <strong class="text-slate-700"><%= arsip.length %></strong> arsip</span>
    </div>
  </div>
</div>