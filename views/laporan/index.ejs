<div class="max-w-7xl mx-auto">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Laporan</h1>
      <p class="text-slate-500 text-sm mt-1">Rekapitulasi dan laporan sistem arsip</p>
    </div>
    <button onclick="window.print()" class="bg-bpn-600 hover:bg-bpn-700 text-white text-sm font-medium px-4 py-2.5 rounded-xl shadow-lg shadow-bpn-600/25 transition-all hover:shadow-xl hover:-translate-y-0.5 print:hidden">
      <i class="fas fa-print mr-2"></i>Cetak Laporan
    </button>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm mb-6 print:hidden">
    <div class="p-5 border-b border-slate-100">
      <form method="GET" class="flex flex-wrap gap-3 items-end">
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Jenis Laporan</label>
          <select name="jenis" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
            <option value="rekap" <%= data.jenis === 'rekap' ? 'selected' : '' %>>Rekap Tahun Berjalan</option>
            <option value="surat-masuk" <%= data.jenis === 'surat-masuk' ? 'selected' : '' %>>Laporan Surat Masuk</option>
            <option value="surat-keluar" <%= data.jenis === 'surat-keluar' ? 'selected' : '' %>>Laporan Surat Keluar</option>
            <option value="sertifikat" <%= data.jenis === 'sertifikat' ? 'selected' : '' %>>Laporan Sertifikat</option>
            <option value="arsip" <%= data.jenis === 'arsip' ? 'selected' : '' %>>Laporan Arsip</option>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Dari Tanggal</label>
          <input type="date" name="dari" value="<%= filters.dari || data.tanggalDari %>" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none">
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wide mb-1">Sampai Tanggal</label>
          <input type="date" name="sampai" value="<%= filters.sampai || data.tanggalSampai %>" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none">
        </div>
        <button type="submit" class="px-4 py-2 bg-bpn-600 hover:bg-bpn-700 text-white rounded-xl text-sm font-medium transition">
          <i class="fas fa-chart-simple mr-1"></i>Tampilkan
        </button>
      </form>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden" id="laporanPrint">
    <div class="p-8 border-b border-slate-100 text-center">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-bpn-100 text-bpn-600 mb-3">
        <i class="fas fa-landmark text-2xl"></i>
      </div>
      <h2 class="text-xl font-bold text-slate-800"><%= data.namaKantor.nama_kantor %></h2>
      <% if (data.namaKantor.alamat_kantor) { %>
      <p class="text-sm text-slate-500 mt-1"><%= data.namaKantor.alamat_kantor %></p>
      <% } %>
      <% if (data.namaKantor.telepon_kantor) { %>
      <p class="text-xs text-slate-400"><i class="fas fa-phone mr-1"></i><%= data.namaKantor.telepon_kantor %> <% if (data.namaKantor.email_kantor) { %>· <i class="fas fa-envelope mr-1"></i><%= data.namaKantor.email_kantor %><% } %></p>
      <% } %>
      <div class="mt-4 h-0.5 bg-gradient-to-r from-transparent via-bpn-600 to-transparent"></div>
      <h3 class="text-lg font-bold text-bpn-700 mt-4">
        <% if (data.jenis === 'rekap') { %>REKAPITULASI TAHUN BERJALAN<% }
           else if (data.jenis === 'surat-masuk') { %>LAPORAN SURAT MASUK<% }
           else if (data.jenis === 'surat-keluar') { %>LAPORAN SURAT KELUAR<% }
           else if (data.jenis === 'sertifikat') { %>LAPORAN SERTIFIKAT TANAH<% }
           else { %>LAPORAN ARSIP DOKUMEN<% } %>
      </h3>
      <p class="text-sm text-slate-500 mt-1">Periode: <%= new Date(data.tanggalDari).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %> s/d <%= new Date(data.tanggalSampai).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
    </div>

    <% if (data.jenis === 'rekap') { %>
    <div class="p-6">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-50 text-left text-[11px] uppercase tracking-wider text-slate-500">
              <th class="px-5 py-3 font-semibold">Bulan</th>
              <th class="px-5 py-3 font-semibold text-center">Surat Masuk</th>
              <th class="px-5 py-3 font-semibold text-center">Surat Keluar</th>
              <th class="px-5 py-3 font-semibold text-center">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% data.rekapBulanan.forEach(r => { %>
            <tr class="hover:bg-slate-50">
              <td class="px-5 py-3 font-medium text-slate-700"><%= r.label %></td>
              <td class="px-5 py-3 text-center text-bpn-600 font-semibold"><%= r.masuk %></td>
              <td class="px-5 py-3 text-center text-emerald-600 font-semibold"><%= r.keluar %></td>
              <td class="px-5 py-3 text-center text-slate-700 font-semibold"><%= r.masuk + r.keluar %></td>
            </tr>
            <% }) %>
            <% const totalM= data.rekapBulanan.reduce((a, b) => a + b.masuk, 0); const totalK = data.rekapBulanan.reduce((a, b) => a + b.keluar, 0); %>
            <tr class="bg-slate-50 font-bold">
              <td class="px-5 py-3 text-slate-800">TOTAL</td>
              <td class="px-5 py-3 text-center text-bpn-700"><%= totalM %></td>
              <td class="px-5 py-3 text-center text-emerald-700"><%= totalK %></td>
              <td class="px-5 py-3 text-center text-slate-800"><%= totalM + totalK %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <% if (data.jenis === 'surat-masuk' || data.jenis === 'rekap') { %>
    <div class="p-6 <% if(data.jenis === 'rekap'){ %>border-t border-slate-100<% } %>">
      <h4 class="font-semibold text-slate-700 mb-4"><i class="fas fa-inbox text-bpn-600 mr-2"></i>Surat Masuk (<%= data.totalSuratMasuk %>)</h4>
      <% if (data.suratMasuk.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-blue-50 text-left text-[11px] uppercase tracking-wider text-slate-500">
              <th class="px-4 py-2.5 font-semibold">No. Surat</th>
              <th class="px-4 py-2.5 font-semibold">Tanggal</th>
              <th class="px-4 py-2.5 font-semibold">Pengirim</th>
              <th class="px-4 py-2.5 font-semibold">Perihal</th>
              <th class="px-4 py-2.5 font-semibold">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% data.suratMasuk.forEach(s => { %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2.5 font-mono text-xs text-bpn-700 font-medium"><%= s.nomor_surat %></td>
              <td class="px-4 py-2.5 text-slate-600"><%= formatTanggalShort(s.tanggal_surat) %></td>
              <td class="px-4 py-2.5 text-slate-700"><%= s.pengirim %></td>
              <td class="px-4 py-2.5 text-slate-600"><%= s.perihal %></td>
              <td class="px-4 py-2.5"><span class="text-[10px] px-2 py-0.5 rounded-full bg-blue-50 text-bpn-600 font-semibold"><%= s.status %></span></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <p class="text-sm text-slate-400 text-center py-6">Tidak ada data surat masuk pada periode ini</p>
      <% } %>

      <% if (data.suratMasukPerKategori && data.suratMasukPerKategori.length > 0) { %>
      <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase mb-2">Per Kategori</p>
          <table class="w-full text-sm">
            <tbody class="divide-y divide-slate-100">
              <% data.suratMasukPerKategori.forEach(k => { %>
              <tr>
                <td class="py-2 text-slate-600"><%= k.nama_kategori || 'Tanpa Kategori' %></td>
                <td class="py-2 text-right font-semibold text-slate-700"><%= k.jumlah %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase mb-2">Tingkat Penyelesaian</p>
          <div class="space-y-3">
            <% const colors = { 'Baru':'bg-blue-500','Diproses':'bg-amber-500','Selesai':'bg-emerald-500','Diteruskan':'bg-violet-500' }; %>
            <% data.suratMasuk.forEach(() => {}); %>
            <% const counts = {}; data.suratMasuk.forEach(s => { counts[s.status] = (counts[s.status] || 0) + 1; }); %>
            <% Object.keys(colors).forEach(status => { const c = counts[status] || 0; const pct = data.totalSuratMasuk ? Math.round(c / data.totalSuratMasuk * 100) : 0; %>
            <div>
              <div class="flex justify-between text-xs text-slate-500 mb-1">
                <span class="font-medium"><%= status %></span>
                <span><%= c %> (<%= pct %>%)</span>
              </div>
              <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                <div class="h-full <%= colors[status] %> rounded-full" style="width: <%= pct %>%"></div>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>

    <% if (data.jenis === 'surat-keluar' || data.jenis === 'rekap') { %>
    <div class="p-6 border-t border-slate-100">
      <h4 class="font-semibold text-slate-700 mb-4"><i class="fas fa-paper-plane text-emerald-600 mr-2"></i>Surat Keluar (<%= data.totalSuratKeluar %>)</h4>
      <% if (data.suratKeluar.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-emerald-50 text-left text-[11px] uppercase tracking-wider text-slate-500">
              <th class="px-4 py-2.5 font-semibold">No. Surat</th>
              <th class="px-4 py-2.5 font-semibold">Tanggal</th>
              <th class="px-4 py-2.5 font-semibold">Tujuan</th>
              <th class="px-4 py-2.5 font-semibold">Perihal</th>
              <th class="px-4 py-2.5 font-semibold">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% data.suratKeluar.forEach(s => { %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2.5 font-mono text-xs text-emerald-700 font-medium"><%= s.nomor_surat %></td>
              <td class="px-4 py-2.5 text-slate-600"><%= formatTanggalShort(s.tanggal_surat) %></td>
              <td class="px-4 py-2.5 text-slate-700"><%= s.tujuan %></td>
              <td class="px-4 py-2.5 text-slate-600"><%= s.perihal %></td>
              <td class="px-4 py-2.5"><span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-600 font-semibold"><%= s.status %></span></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <p class="text-sm text-slate-400 text-center py-6">Tidak ada data surat keluar pada periode ini</p>
      <% } %>
    </div>
    <% } %>

    <% if (data.jenis === 'sertifikat' || data.jenis === 'rekap') { %>
    <div class="p-6 border-t border-slate-100">
      <h4 class="font-semibold text-slate-700 mb-4"><i class="fas fa-file-contract text-violet-600 mr-2"></i>Sertifikat Tanah (<%= data.totalSertifikat %>)</h4>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-5">
        <div class="bg-violet-50 rounded-xl p-4 text-center">
          <p class="text-2xl font-bold text-violet-700"><%= data.totalSertifikat %></p>
          <p class="text-xs text-violet-500 font-medium mt-1">Total Sertifikat</p>
        </div>
        <% if (data.totalLuas) { %>
        <div class="bg-emerald-50 rounded-xl p-4 text-center">
          <p class="text-2xl font-bold text-emerald-700"><%= Number(data.totalLuas.total || 0).toLocaleString('id-ID') %></p>
          <p class="text-xs text-emerald-500 font-medium mt-1">Total Luas Terdata (m²)</p>
        </div>
        <% } %>
        <div class="bg-bpn-50 rounded-xl p-4 text-center">
          <p class="text-2xl font-bold text-bpn-700"><%= data.sertifikatPerJenis.length %></p>
          <p class="text-xs text-bpn-500 font-medium mt-1">Jenis Sertifikat</p>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase mb-2">Per Jenis</p>
          <table class="w-full text-sm">
            <tbody class="divide-y divide-slate-100">
              <% data.sertifikatPerJenis.forEach(j => { %>
              <tr>
                <td class="py-2 text-slate-600"><%= j.jenis_sertifikat %></td>
                <td class="py-2 text-right font-semibold text-slate-700"><%= j.jumlah %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase mb-2">Per Status</p>
          <table class="w-full text-sm">
            <tbody class="divide-y divide-slate-100">
              <% data.sertifikatPerStatus.forEach(s => { %>
              <tr>
                <td class="py-2 text-slate-600"><%= s.status_sertifikat %></td>
                <td class="py-2 text-right font-semibold text-slate-700"><%= s.jumlah %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <% } %>

    <% if (data.jenis === 'arsip' || data.jenis === 'rekap') { %>
    <div class="p-6 border-t border-slate-100">
      <h4 class="font-semibold text-slate-700 mb-4"><i class="fas fa-box-archive text-slate-600 mr-2"></i>Arsip Dokumen (<%= data.totalArsip %>)</h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase mb-2">Per Kategori</p>
          <table class="w-full text-sm">
            <tbody class="divide-y divide-slate-100">
              <% data.arsipPerKategori.forEach(k => { %>
              <tr>
                <td class="py-2 text-slate-600"><%= k.kategori %></td>
                <td class="py-2 text-right font-semibold text-slate-700"><%= k.jumlah %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="flex items-center justify-center">
          <div class="text-center bg-slate-50 rounded-2xl p-8 w-full">
            <div class="text-4xl text-slate-300 mb-2"><i class="fas fa-boxes-stacked"></i></div>
            <p class="text-3xl font-bold text-slate-700"><%= data.totalArsip %></p>
            <p class="text-xs text-slate-400 mt-1">Total Arsip Terdata</p>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <div class="px-8 py-5 border-t border-slate-100 flex justify-between items-center text-xs text-slate-400">
      <span>Dibuat: <%= new Date().toLocaleString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
      <span>Oleh: <%= user.nama_lengkap %> (<%= user.role %>)</span>
    </div>
  </div>
</div>

<style>
  @media print {
    aside, header, .print\:hidden { display: none !important; }
    main { margin-left: 0 !important; padding-top: 0 !important; padding: 0 !important; }
    body { background: white !important; }
  }
</style>