<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="bg-slate-100 font-sans flex items-center justify-center min-h-screen">
  <div class="text-center p-8 max-w-lg">
    <div class="text-7xl mb-4" style="color:#f87171;"><i class="fas fa-triangle-exclamation"></i></div>
    <h1 class="text-4xl font-bold text-slate-700">500</h1>
    <p class="text-slate-500 mt-2 mb-2">Terjadi kesalahan pada server</p>
    <% if (typeof message !== 'undefined') { %>
      <p class="text-xs text-red-400 bg-red-50 border border-red-100 rounded-lg p-3 font-mono break-all mb-6"><%= message %></p>
    <% } else { %>
      <p class="text-slate-400 text-sm mb-6">Silakan coba lagi atau hubungi administrator</p>
    <% } %>
    <a href="/dashboard" class="inline-block px-6 py-3 bg-bpn-600 text-white rounded-xl text-sm font-semibold hover:bg-bpn-700 transition">Kembali ke Dashboard</a>
  </div>
</body>
</html>