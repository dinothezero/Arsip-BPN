<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <a href="/surat-masuk" class="text-sm text-slate-500 hover:text-bpn-600 transition mb-1 inline-flex items-center gap-2">
        <i class="fas fa-arrow-left text-xs"></i> Kembali
      </a>
      <h1 class="text-2xl font-bold text-slate-800 mt-1">Tambah Surat Masuk</h1>
      <p class="text-slate-500 text-sm mt-1">Registrasi surat masuk baru ke sistem</p>
    </div>
  </div>

  <form method="POST" action="/surat-masuk/create" enctype="multipart/form-data" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="border-b border-slate-100 px-6 py-4 bg-slate-50">
      <h3 class="font-semibold text-slate-700"><i class="fas fa-id-card text-bpn-600 mr-2"></i>Informasi Surat</h3>
    </div>

    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Nomor Surat <span class="text-red-500">*</span></label>
        <input type="text" name="nomor_surat" value="<%= nomorAgenda %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 focus:border-bpn-500 outline-none transition font-mono" required>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Kategori Surat</label>
        <select name="kategori_id" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
          <option value="">-- Pilih Kategori --</option>
          <% kategoriList.forEach(k => { %>
            <option value="<%= k.id %>"><%= k.nama_kategori %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Tanggal Surat <span class="text-red-500">*</span></label>
        <input type="date" name="tanggal_surat" value="<%= new Date().toISOString().slice(0,10) %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none" required>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Tanggal Diterima <span class="text-red-500">*</span></label>
        <input type="date" name="tanggal_diterima" value="<%= new Date().toISOString().slice(0,10) %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none" required>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Pengirim <span class="text-red-500">*</span></label>
        <input type="text" name="pengirim" placeholder="Nama instansi / pengirim surat" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition" required>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Diterima Oleh</label>
        <select name="diterima_oleh" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
          <option value="">-- Pilih Petugas --</option>
          <% users.forEach(u => { %>
            <option value="<%= u.nama_lengkap %>" <%= u.id === user.id ? 'selected' : '' %>><%= u.nama_lengkap %></option>
          <% }) %>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Perihal <span class="text-red-500">*</span></label>
        <input type="text" name="perihal" placeholder="Perihal / hal surat" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition" required>
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Keterangan / Isi Singkat</label>
        <textarea name="keterangan" rows="3" placeholder="Ringkasan keterangan surat..." class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition resize-y"></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Lampiran</label>
        <input type="text" name="lampiran" placeholder="Contoh: 2 lembar, 1 berkas" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Status Awal</label>
        <select name="status" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
          <option value="Baru" selected>Baru</option>
          <option value="Diproses">Diproses</option>
          <option value="Selesai">Selesai</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Disposisi (Arahan)</label>
        <input type="text" name="disposisi" placeholder="Contoh: Seksi Survei Pemetaan" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Upload File Surat</label>
        <div class="relative">
          <input type="file" name="file_surat" id="fileInput" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
          <div id="fileDrop" class="border-2 border-dashed border-slate-300 rounded-xl p-4 text-center hover:border-bpn-500 hover:bg-bpn-50 transition cursor-pointer">
            <i class="fas fa-cloud-arrow-up text-slate-400 text-xl mb-1 block"></i>
            <p class="text-xs text-slate-500 font-medium" id="fileName">Klik untuk upload file (PDF, DOC, Gambar)</p>
            <p class="text-[10px] text-slate-400 mt-0.5">Maksimal 10MB</p>
          </div>
        </div>
      </div>
    </div>

    <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-3">
      <a href="/surat-masuk" class="px-5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-200 transition">Batal</a>
      <button type="submit" class="px-6 py-2.5 bg-bpn-600 hover:bg-bpn-700 text-white rounded-xl text-sm font-semibold shadow-lg shadow-bpn-600/25 transition-all hover:shadow-xl">
        <i class="fas fa-save mr-2"></i>Simpan Surat Masuk
      </button>
    </div>
  </form>
</div>

<script>
  const fileInput = document.getElementById('fileInput');
  fileInput.addEventListener('change', function() {
    if (this.files.length > 0) {
      document.getElementById('fileName').textContent = this.files[0].name;
    }
  });
</script>