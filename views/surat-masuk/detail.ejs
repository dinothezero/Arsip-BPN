<div class="max-w-5xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <a href="/surat-masuk" class="text-sm text-slate-500 hover:text-bpn-600 transition mb-1 inline-flex items-center gap-2">
        <i class="fas fa-arrow-left text-xs"></i> Kembali
      </a>
      <h1 class="text-2xl font-bold text-slate-800 mt-1">Detail Surat Masuk</h1>
    </div>
    <div class="flex gap-2">
      <a href="/surat-masuk/<%= surat.id %>/edit" class="px-4 py-2.5 bg-amber-500 hover:bg-amber-600 text-white rounded-xl text-sm font-medium transition shadow-lg shadow-amber-500/25">
        <i class="fas fa-pen mr-1"></i>Edit
      </a>
      <button onclick="window.print()" class="px-4 py-2.5 bg-slate-600 hover:bg-slate-700 text-white rounded-xl text-sm font-medium transition">
        <i class="fas fa-print mr-1"></i>Cetak
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-6 py-4 bg-gradient-to-r from-bpn-600 to-bpn-700 flex items-center justify-between">
        <h3 class="font-semibold text-white"><i class="fas fa-file-lines mr-2"></i>Informasi Surat</h3>
        <span class="text-xs px-3 py-1 rounded-full bg-white/20 text-white font-semibold"><%= surat.status %></span>
      </div>

      <div class="p-6 space-y-5">
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Nomor Surat</p>
            <p class="text-sm font-semibold text-slate-800 mt-1 break-words"><%= surat.nomor_surat %></p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Kategori</p>
            <p class="text-sm font-semibold text-slate-800 mt-1"><%= surat.nama_kategori || '-' %></p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Tanggal Surat</p>
            <p class="text-sm font-semibold text-slate-800 mt-1"><%= formatTanggal(surat.tanggal_surat) %></p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Tanggal Diterima</p>
            <p class="text-sm font-semibold text-slate-800 mt-1"><%= formatTanggal(surat.tanggal_diterima) %></p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4 sm:col-span-2">
            <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Pengirim</p>
            <p class="text-sm font-semibold text-slate-800 mt-1"><%= surat.pengirim %></p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4 sm:col-span-2">
            <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Perihal</p>
            <p class="text-sm font-semibold text-slate-800 mt-1"><%= surat.perihal %></p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Diterima Oleh</p>
            <p class="text-sm font-semibold text-slate-800 mt-1"><%= surat.diterima_oleh || '-' %></p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Disposisi</p>
            <p class="text-sm font-semibold text-slate-800 mt-1"><%= surat.disposisi || '-' %></p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Lampiran</p>
            <p class="text-sm font-semibold text-slate-800 mt-1"><%= surat.lampiran || '-' %></p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Diinput Oleh</p>
            <p class="text-sm font-semibold text-slate-800 mt-1"><%= surat.nama_operator || '-' %></p>
          </div>
        </div>

        <% if (surat.keterangan) { %>
        <div>
          <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide mb-1">Keterangan</p>
          <p class="text-sm text-slate-600 bg-slate-50 rounded-xl p-4"><%= surat.keterangan %></p>
        </div>
        <% } %>

        <% if (surat.file_surat) { %>
        <div class="flex items-center justify-between bg-emerald-50 border border-emerald-200 rounded-xl p-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center">
              <i class="fas fa-file-pdf"></i>
            </div>
            <div>
              <p class="text-sm font-semibold text-emerald-800">Dokumen Terlampir</p>
              <p class="text-xs text-emerald-600"><%= surat.file_surat %></p>
            </div>
          </div>
          <a href="/uploads/surat-masuk/<%= surat.file_surat %>" target="_blank" class="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-medium transition">
            <i class="fas fa-download mr-1"></i>Unduh
          </a>
        </div>
        <% } %>
      </div>

      <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
        <span>Dibuat: <%= new Date(surat.created_at).toLocaleString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
        <form method="POST" action="/surat-masuk/<%= surat.id %>/delete" onsubmit="return confirm('Yakin ingin menghapus surat ini?')">
          <button type="submit" class="text-red-500 hover:text-red-700 font-medium inline-flex items-center gap-1">
            <i class="fas fa-trash text-xs"></i> Hapus Surat
          </button>
        </form>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
        <div class="px-5 py-4 border-b border-slate-100">
          <h3 class="font-semibold text-slate-700"><i class="fas fa-arrows-rotate text-bpn-600 mr-2"></i>Ubah Status</h3>
        </div>
        <div class="p-5">
          <form method="POST" action="/surat-masuk/<%= surat.id %>/status" class="flex gap-2">
            <select name="status" class="flex-1 px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
              <% ['Baru','Diproses','Selesai','Diteruskan'].forEach(s => { %>
                <option value="<%= s %>" <%= surat.status === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
            <button type="submit" class="px-4 py-2 bg-bpn-600 hover:bg-bpn-700 text-white rounded-xl text-sm font-medium transition">
              <i class="fas fa-check"></i>
            </button>
          </form>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
        <div class="px-5 py-4 border-b border-slate-100">
          <h3 class="font-semibold text-slate-700"><i class="fas fa-share-nodes text-bpn-600 mr-2"></i>Buat Disposisi</h3>
        </div>
        <div class="p-5">
          <form method="POST" action="/surat-masuk/<%= surat.id %>/disposisi" class="space-y-3">
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1">Diteruskan Ke</label>
              <select name="diteruskan_ke" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white" required>
                <option value="">-- Pilih Seksi/Unit --</option>
                <optgroup label="Bangunan User">
                  <% users.forEach(u => { %>
                    <option value="<%= u.nama_lengkap %>"><%= u.nama_lengkap %> (<%= u.jabatan %>)</option>
                  <% }) %>
                </optgroup>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1">Prioritas</label>
              <select name="prioritas" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
                <option value="Biasa">Biasa</option>
                <option value="Penting">Penting</option>
                <option value="Segera">Segera</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1">Catatan</label>
              <textarea name="catatan" rows="2" placeholder="Catatan disposisi..." class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none resize-none"></textarea>
            </div>
            <button type="submit" class="w-full px-4 py-2.5 bg-bpn-600 hover:bg-bpn-700 text-white rounded-xl text-sm font-medium transition">
              <i class="fas fa-paper-plane mr-1"></i>Teruskan
            </button>
          </form>
        </div>
      </div>

      <% if (disposisiList.length > 0) { %>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
        <div class="px-5 py-4 border-b border-slate-100">
          <h3 class="font-semibold text-slate-700"><i class="fas fa-list-check text-bpn-600 mr-2"></i>Riwayat Disposisi</h3>
        </div>
        <div class="p-5 space-y-3">
          <% disposisiList.forEach(d => { %>
          <div class="border border-slate-100 rounded-xl p-3 <%= d.prioritas === 'Segera' ? 'border-red-200 bg-red-50/50' : d.prioritas === 'Penting' ? 'border-amber-200 bg-amber-50/50' : '' %>">
            <div class="flex items-start justify-between gap-2">
              <p class="text-sm font-medium text-slate-700"><%= d.diteruskan_ke %></p>
              <span class="text-[10px] px-2 py-0.5 rounded-full font-semibold
                <%= d.prioritas === 'Segera' ? 'bg-red-100 text-red-600' : d.prioritas === 'Penting' ? 'bg-amber-100 text-amber-600' : 'bg-slate-100 text-slate-500' %>">
                <%= d.prioritas %>
              </span>
            </div>
            <% if (d.catatan) { %><p class="text-xs text-slate-500 mt-1"><%= d.catatan %></p><% } %>
            <p class="text-[11px] text-slate-400 mt-2">
              oleh <%= d.nama_user || '-' %> · <%= new Date(d.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
            </p>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</div>

<style>
  @media print {
    aside, header, .flex > a, .flex > button { display: none !important; }
    main { margin-left: 0 !important; padding-top: 0 !important; }
  }
</style>