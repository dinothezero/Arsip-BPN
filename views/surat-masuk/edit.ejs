<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <a href="/surat-masuk" class="text-sm text-slate-500 hover:text-bpn-600 transition mb-1 inline-flex items-center gap-2">
        <i class="fas fa-arrow-left text-xs"></i> Kembali
      </a>
      <h1 class="text-2xl font-bold text-slate-800 mt-1">Edit Surat Masuk</h1>
      <p class="text-slate-500 text-sm mt-1">Ubah data surat masuk</p>
    </div>
  </div>

  <form method="POST" action="/surat-masuk/<%= surat.id %>/edit" enctype="multipart/form-data" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <input type="hidden" name="existing_file" value="<%= surat.file_surat || '' %>">

    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Nomor Surat <span class="text-red-500">*</span></label>
        <input type="text" name="nomor_surat" value="<%= surat.nomor_surat %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition font-mono" required>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Kategori Surat</label>
        <select name="kategori_id" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
          <option value="">-- Pilih Kategori --</option>
          <% kategoriList.forEach(k => { %>
            <option value="<%= k.id %>" <%= surat.kategori_id === k.id ? 'selected' : '' %>><%= k.nama_kategori %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Tanggal Surat <span class="text-red-500">*</span></label>
        <input type="date" name="tanggal_surat" value="<%= surat.tanggal_surat %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none" required>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Tanggal Diterima <span class="text-red-500">*</span></label>
        <input type="date" name="tanggal_diterima" value="<%= surat.tanggal_diterima %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none" required>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Pengirim <span class="text-red-500">*</span></label>
        <input type="text" name="pengirim" value="<%= surat.pengirim %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition" required>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Diterima Oleh</label>
        <input type="text" name="diterima_oleh" value="<%= surat.diterima_oleh || '' %>" placeholder="Nama penerima surat" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition">
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Perihal <span class="text-red-500">*</span></label>
        <input type="text" name="perihal" value="<%= surat.perihal %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition" required>
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Keterangan</label>
        <textarea name="keterangan" rows="3" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition resize-y"><%= surat.keterangan || '' %></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Lampiran</label>
        <input type="text" name="lampiran" value="<%= surat.lampiran || '' %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Status</label>
        <select name="status" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none bg-white">
          <% ['Baru','Diproses','Selesai','Diteruskan'].forEach(s => { %>
            <option value="<%= s %>" <%= surat.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Disposisi</label>
        <input type="text" name="disposisi" value="<%= surat.disposisi || '' %>" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-bpn-500 outline-none transition">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Upload File Baru</label>
        <input type="file" name="file_surat" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" class="w-full text-sm text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-bpn-50 file:text-bpn-700 hover:file:bg-bpn-100">
        <% if (surat.file_surat) { %>
          <p class="text-[11px] text-emerald-600 mt-1"><i class="fas fa-file mr-1"></i>File saat ini: <%= surat.file_surat %></p>
        <% } %>
      </div>
    </div>

    <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-3">
      <a href="/surat-masuk/<%= surat.id %>" class="px-5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-200 transition">Batal</a>
      <button type="submit" class="px-6 py-2.5 bg-bpn-600 hover:bg-bpn-700 text-white rounded-xl text-sm font-semibold shadow-lg shadow-bpn-600/25 transition-all hover:shadow-xl">
        <i class="fas fa-save mr-2"></i>Simpan Perubahan
      </button>
    </div>
  </form>
</div>